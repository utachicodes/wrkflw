{
  "name": "wrkflw",
  "version": "0.0.0",
  "private": true,
  "description": "One board where people and coding agents share the same work.",
  "scripts": {
    "dev": "sh scripts/dev.sh",
    "dev:web": "vite --config web/vite.config.mts",
    "build:web": "vite build --config web/vite.config.mts",
    "typecheck:web": "tsc -p web/tsconfig.json --noEmit",
    "test:react": "vitest run --config web/vitest.config.mts",
    "verify:browser": "playwright --version",
    "test:web": "npm run typecheck:web && npm run test:react",
    "test:browser": "npm run build:web && node --test --test-concurrency=1 --test-timeout=600000 web/tests/editor.browser.test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/utachicodes/wrkflw.git"
  },
  "keywords": [],
  "author": "",
  "bugs": {
    "url": "https://github.com/utachicodes/wrkflw/issues"
  },
  "homepage": "https://github.com/utachicodes/wrkflw#readme",
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "playwright": "^1.64.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@tanstack/react-query": "^5.105.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.63.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-qr-code": "^2.2.0",
    "react-router-dom": "^7.18.5",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  }
}
